SUPABASE_ANON_KEY=
# Somente no runtime do servidor. Nunca use VITE_ nem exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback legado temporário de métricas
STRIPE_SECRET_KEY=
STRIPE_WAGOO_PRICE_IDS=
STRIPE_2AVENDAS_PRICE_IDS=

# Opcional — só para admin/reconcile do produto Wagoo (não usado em /monitoramento MP).
# Monitoramento MP no Korven = SUPABASE_* (payment_events + notifications via Edge ingest).
WAGOO_API_BASE_URL=
WAGOO_METRICS_API_KEY=
ADMIN_API_SECRET=
