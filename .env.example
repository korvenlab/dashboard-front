# Autenticação atual do dashboard
KORVEN_DASHBOARD_USER=
KORVEN_DASHBOARD_PASSWORD=
KORVEN_DASHBOARD_SESSION_SECRET=

# Supabase central (nomes canônicos; não use aliases)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Somente no runtime do servidor. Nunca use VITE_ nem exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback legado temporário de métricas
STRIPE_SECRET_KEY=
STRIPE_WAGOO_PRICE_IDS=
STRIPE_2AVENDAS_PRICE_IDS=

# Opcional: webhooks crus do wag-backend em /monitoramento
# (se ausente, usa fallback https://wag-backend.onrender.com + ingest central)
WAGOO_API_BASE_URL=https://wag-backend.onrender.com
WAGOO_METRICS_API_KEY=
# ou o mesmo ADMIN_API_SECRET do wag-backend
ADMIN_API_SECRET=
