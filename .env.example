# Autenticação atual do dashboard
KORVEN_DASHBOARD_USER=
KORVEN_DASHBOARD_PASSWORD=
KORVEN_DASHBOARD_SESSION_SECRET=

# Supabase central (nomes canônicos; não use aliases)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Somente no runtime do servidor. Nunca use VITE_ nem exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback legado temporário de métricas
STRIPE_SECRET_KEY=
STRIPE_WAGOO_PRICE_IDS=
STRIPE_2AVENDAS_PRICE_IDS=

# Opcional — UptimeRobot direto (sem Render / DASHBOARD_BACKEND_*).
UPTIMEROBOT_API_KEY=

# Opcional — deploys no /monitoramento (Vercel + Render).
# Vercel: Settings → Tokens. Team ID em Team Settings → General.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Nomes dos projetos (vírgula). Default: dashboard-front,wagbot,2-a-front,korvenlab
VERCEL_MONITOR_PROJECTS=
# Render: Account Settings → API Keys.
RENDER_API_KEY=
# Nomes/fragmentos dos serviços (vírgula). Default: wag-backend,wag,wagoo
RENDER_MONITOR_SERVICES=

# Opcional — só para admin/reconcile do produto Wagoo (não usado em /monitoramento MP).
# Monitoramento MP no Korven = SUPABASE_* (payment_events + notifications via Edge ingest).
WAGOO_API_BASE_URL=
WAGOO_METRICS_API_KEY=
ADMIN_API_SECRET=
